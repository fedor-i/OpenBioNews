{
  "version": 1,
  "profile": {
    "title": "Daily Bio Brief",
    "intro": "Your daily brief from official primary sources.",
    "bundles": []
  },
  "feeds": [],
  "filters": {
    "max_age_hours": 48,
    "max_items": 40,
    "max_per_topic": 12,
    "include_keywords": [],
    "exclude_keywords": [],
    "similarity_threshold": 0.5
  },
  "llm": {
    "backend": "none",
    "model": "",
    "base_url": "",
    "api_key_env": "OPENAI_API_KEY",
    "temperature": 0.3,
    "max_tokens": 220,
    "timeout": 60
  },
  "output": {
    "format": "markdown",
    "group_by": "topic",
    "path": "digest",
    "write_file": true,
    "summaries": true,
    "why_it_matters": false
  },
  "history": {
    "enabled": true,
    "path": "digest/state.json"
  },
  "email": {
    "enabled": false,
    "smtp_host": "",
    "smtp_port": 587,
    "use_tls": true,
    "username": "",
    "password_env": "OPENBIONEWS_SMTP_PASSWORD",
    "from_addr": "",
    "to_addrs": []
  },
  "watchlist": {
    "sponsors": [],
    "conditions": [],
    "interventions": [],
    "terms": []
  },
  "connectors": {
    "clinicaltrials": {
      "enabled": false,
      "recent_days": 30,
      "max_per_query": 20,
      "max_total": 60,
      "statuses": []
    },
    "openfda": {
      "enabled": true,
      "recent_days": 30,
      "max_per_query": 20,
      "max_total": 40,
      "classifications": []
    },
    "openfda_approvals": {
      "enabled": true,
      "recent_days": 90,
      "max_per_query": 20,
      "max_total": 40,
      "include_supplements": true
    },
    "openfda_shortages": {
      "enabled": true,
      "recent_days": 60,
      "max_per_query": 20,
      "max_total": 40,
      "statuses": [
        "Current"
      ]
    },
    "openfda_events": {
      "enabled": false,
      "top_reactions": 8,
      "max_total": 20
    },
    "openfda_labels": {
      "enabled": false,
      "summary_chars": 600,
      "max_total": 20
    },
    "federalregister": {
      "enabled": true,
      "recent_days": 30,
      "max_per_query": 20,
      "max_total": 40,
      "agencies": [
        "food-and-drug-administration"
      ]
    },
    "pubmed": {
      "enabled": false,
      "recent_days": 365,
      "max_per_query": 10,
      "max_total": 30,
      "api_key": ""
    },
    "edgar": {
      "enabled": false,
      "recent_days": 30,
      "forms": [
        "8-K"
      ],
      "max_per_query": 20,
      "max_total": 40,
      "user_agent": ""
    }
  }
}
